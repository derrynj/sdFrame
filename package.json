{
  "name": "sdframe",
  "version": "2.0.4",
  "description": "Multi-window kiosk-style web container",
  "main": "dist/main/index.js",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.js",
    "make-ico": "node scripts/make-ico.js",
    "bundle-preload": "node scripts/bundle-preload.js",
    "notices": "node scripts/generate-third-party-notices.js",
    "build": "tsc && npm run bundle-preload && npm run copy-assets",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test tests/snap-geometry.test.cjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "installer": "npm run build && electron-builder --win nsis --publish never",
    "portable": "npm run build && electron-builder --win portable --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:signed": "node scripts/dist-with-signing.js"
  },
  "author": "Derryn Jones",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^3.22.4"
  },
  "build": {
    "appId": "com.sdframe.app",
    "productName": "sdFrame",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "default-config.json"
    ],
    "extraResources": [
      {
        "from": "default-config.json",
        "to": "default-config.json"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "sdFrame-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "sdFrame-${version}-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "derrynj",
      "repo": "sdFrame",
      "releaseType": "release"
    }
  }
}
